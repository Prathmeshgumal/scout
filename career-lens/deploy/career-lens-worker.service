# The native worker. It drives a headed Chrome, so it runs in your desktop session and not in Docker.
#
#   systemctl --user enable --now "$PWD/deploy/career-lens-worker.service"
#   systemctl --user status career-lens-worker
#   journalctl --user -u career-lens-worker -f
[Unit]
Description=career-lens native worker
After=graphical-session.target
PartOf=graphical-session.target

[Service]
WorkingDirectory=%h/razorpay/career-lens
ExecStart=%h/razorpay/career-lens/.venv/bin/career-lens supervisor --env-file .env --config deploy/supervisor.json
Restart=on-failure
RestartSec=15
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=graphical-session.target
