# Copy to .env with `uv run python scripts/init_local_env.py`, which also
# generates the credential key. docker compose reads .env automatically.
# The supervisor is not a container, so pass the file to it:
#
#     uv run career-lens supervisor --env-file .env --config deploy/supervisor.json
#
# Single-quote any value containing quotes, spaces, `#` or `$`.

# Versioned AES-256 keys for write-only LinkedIn passwords. Never commit a real
# key. The active version must exist in the JSON map.
# CAREER_LENS_CREDENTIAL_KEYS='{"1":"<base64-encoded-32-byte-key>"}'
# CAREER_LENS_CREDENTIAL_ACTIVE_KEY=1

# What the supervisor uses to reach the services published on this machine.
CAREER_LENS_DATABASE_URL=postgresql+psycopg://career_lens_app:career-lens-dev-secret@127.0.0.1:5433/career_lens
CAREER_LENS_S3_ENDPOINT=http://127.0.0.1:9002

# Change these before exposing anything beyond this machine.
# CAREER_LENS_PG_PASSWORD=career-lens-dev-secret
# CAREER_LENS_S3_ACCESS_KEY=career_lens
# CAREER_LENS_S3_SECRET_KEY=career-lens-dev-secret
# CAREER_LENS_MINIO_ROOT_USER=career-lens-root
# CAREER_LENS_MINIO_ROOT_PASSWORD=career-lens-root-dev-secret

# Ports on 127.0.0.1.
# CAREER_LENS_API_PORT=8090
# CAREER_LENS_POSTGRES_PORT=5433
# CAREER_LENS_MINIO_PORT=9002
# CAREER_LENS_MINIO_CONSOLE_PORT=9003

# How long a presigned artifact link lasts, in seconds.
# CAREER_LENS_ARTIFACT_URL_TTL_SECONDS=604800
