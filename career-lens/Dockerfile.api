# The JSON service and console page. It contains no browser driver, Chrome, or
# browser profile.
FROM node:22-slim AS web
WORKDIR /app/web
COPY web/ ./
RUN npm ci && npm run build

FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Keep the dependency layer independent from source changes. Default groups
# are omitted and only extraction is opted in, so Patchright stays on hosts.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --group extract --no-default-groups

COPY src/ ./src/
COPY --from=web /app/src/career_lens/api/console_dist/ ./src/career_lens/api/console_dist/
RUN uv sync --frozen --group extract --no-default-groups

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8080
CMD ["uvicorn", "career_lens.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
