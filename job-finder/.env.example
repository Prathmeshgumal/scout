# Claude: set one of the two. The API key wins when both are set. `job-finder login` fills them in.
ANTHROPIC_API_KEY=
# A Claude subscription token from `claude setup-token` (sk-ant-oat...)
CLAUDE_CODE_OAUTH_TOKEN=
JOB_FINDER_MODEL=claude-sonnet-5-5
JOB_FINDER_EFFORT=medium
# Small model that answers a question from one web page (read_page)
JOB_FINDER_READ_MODEL=claude-haiku-5-5
# Its effort: low, medium, high, xhigh or max. Not sent to claude-haiku-4-5, which rejects it.
JOB_FINDER_READ_EFFORT=medium

# The password of the dashboard. With no password, nobody can sign in.
JOB_FINDER_PASSWORD=

# career-lens: the API of the running stack, and a customer key (cl_v1.)
CAREER_LENS_BASE_URL=http://127.0.0.1:8090
CAREER_LENS_API_KEY=
# Age of a stored search, page or company that career-lens gives again instead of a new capture
# (a number and m, h or d, for example 90m, 24h or 7d)
CAREER_LENS_FRESHNESS=7d
# Fresh LinkedIn company scrapes for each mission
JOB_FINDER_MAX_FRESH_SCRAPES=15
# Minutes that a subagent waits for its own scrapes (wait_for_scrapes)
JOB_FINDER_SCRAPE_WAIT_MINUTES=1
# Minutes that google_search and read_page wait for career-lens
JOB_FINDER_WEB_WAIT_MINUTES=5
# Hours a mission waits for its scrapes before it finishes with what it has
JOB_FINDER_MAX_WAIT_HOURS=72
# Seconds between checks of pending scrapes in career-lens
JOB_FINDER_WATCH_INTERVAL_S=10

# Postgres from docker-compose.yml
DATABASE_URL=postgresql://jobfinder:jobfinder@127.0.0.1:55433/job_finder

# MinIO keeps the files that the user uploads: docker-compose.yml starts it
JOB_FINDER_S3_ENDPOINT=http://127.0.0.1:9004
JOB_FINDER_S3_ACCESS_KEY=jobfinder
JOB_FINDER_S3_SECRET_KEY=jobfinder-dev-secret
JOB_FINDER_S3_BUCKET=job-finder
# Where the Agent SDK keeps Claude's session files, and the agent's working directory
CLAUDE_CONFIG_DIR=var/claude
JOB_FINDER_CWD=var/agent

# Limits (for each mission unless noted)
JOB_FINDER_MAX_TURNS=40
JOB_FINDER_MAX_SPEND_USD=2.00
# Total spend of a new schedule: the schedule ends at it. The user can give another limit in the chat.
JOB_FINDER_MANDATE_TOTAL_USD=10.00
# Failed missions in a row that pause a schedule. After a resume, it pauses again after as many new failures. 0: never.
JOB_FINDER_MANDATE_MAX_FAILURES=3
# Time limit of each mission of a new schedule, in minutes of run time. Then no new work starts.
JOB_FINDER_MANDATE_TIME_LIMIT_MINUTES=120
# Extra time to finish the work in progress after the time limit, in minutes. Then all work stops.
JOB_FINDER_MANDATE_GRACE_MINUTES=30
# Subagents that run at the same time in one mission
JOB_FINDER_MAX_SUBAGENTS=5
# Days that company facts stay current, also for other missions. Older facts are found again.
JOB_FINDER_RESEARCH_MAX_AGE_DAYS=30

# Web app (job-finder serve): address, and the minutes before an idle mission session closes
JOB_FINDER_HOST=127.0.0.1
JOB_FINDER_PORT=8000
JOB_FINDER_IDLE_MINUTES=10
